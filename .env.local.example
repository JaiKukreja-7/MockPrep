# Copy this file to .env.local and fill in real values.
# .env* is gitignored (with an exception for this template); never commit the
# filled-in file.

# --- Supabase — Project Settings → API -------------------------------------
# Public/publishable key only. There is no service-role key in this app; all
# privileged work happens in SECURITY DEFINER functions behind RLS.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY

# --- LLM providers ---------------------------------------------------------
# Server-side only: no NEXT_PUBLIC_ prefix, read solely in lib/llm/registry.ts,
# which imports "server-only" so an accidental client import is a build error.

# Google AI Studio — aistudio.google.com
# Question generation and the voice interviewer's bridge lines.
GEMINI_API_KEY=

# Groq — console.groq.com
# Answer scoring, flag extraction, Whisper STT, and the only provider allowed
# to see resume content (see lib/llm/routing.ts).
GROQ_API_KEY=

# OpenRouter — openrouter.ai
# Fallback leg for scoring and flag extraction.
OPENROUTER_API_KEY=
