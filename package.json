{
  "name": "mockprep",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run test:unit && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "next build && vitest run --project e2e",
    "test:coverage": "vitest run --project unit --project integration --coverage",
    "measure:follow-up": "FOLLOW_UP_RATE=1 FOLLOW_UP_REPEATS=3 vitest run --project integration tests/integration/follow-up-rate.test.ts --reporter=verbose",
    "measure:model-answers": "MODEL_ANSWER_ROUTE=1 vitest run --project integration tests/integration/model-answer-route.test.ts --reporter=verbose"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.6",
    "@supabase/supabase-js": "^2.115.0",
    "mammoth": "^1.12.2",
    "next": "16.3.4",
    "pdfjs-dist": "^6.3.289",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.13.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^5.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "playwright": "1.63",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
